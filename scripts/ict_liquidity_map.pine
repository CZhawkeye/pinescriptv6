//@version=6
indicator("ICT Liquidity Map", shorttitle="ICT Liq", overlay=true,
     max_lines_count=300, max_boxes_count=100, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════

grpSW   = "Swing Structure"
i_swLeft  = input.int(5,    "Left Bars",           minval=1, maxval=20,  group=grpSW)
i_swRight = input.int(5,    "Right Bars",          minval=1, maxval=20,  group=grpSW)
i_swShow  = input.bool(true, "Show Swing Levels",                        group=grpSW)
i_swMax   = input.int(4,    "Max Levels",          minval=2, maxval=20,  group=grpSW)

grpEQ   = "Equal Highs / Lows"
i_eqShow  = input.bool(true,  "Show EQH / EQL",                         group=grpEQ)
i_eqTol   = input.float(0.05, "Tolerance (%)", minval=0.01, maxval=0.5, group=grpEQ, step=0.01)

grpPD   = "Session Levels"
i_pdShow  = input.bool(true,  "Show PDH / PDL",                         group=grpPD)
i_pwShow  = input.bool(false, "Show PWH / PWL",                         group=grpPD)

grpHTF  = "Higher Timeframe"
i_htfShow = input.bool(true,       "Show HTF Swings",                   group=grpHTF)
i_htfTF   = input.timeframe("60",  "Timeframe",                         group=grpHTF)

grpFP   = "Footprint Delta (Premium)"
i_fpShow  = input.bool(false, "Show Volume Delta",                      group=grpFP)
i_fpTicks = input.int(4,     "Ticks Per Row",      minval=1,            group=grpFP)

grpVis  = "Visual"
i_ext     = input.int(30,    "Extend Right (bars)", minval=5, maxval=200, group=grpVis)
i_swept   = input.bool(true, "Mark Swept Zones",                         group=grpVis)

// ══════════════════════════════════════════════════════════════════
//  COLORS
//  Green family = liquidity ABOVE price (buyside)
//  Red family   = liquidity BELOW price (sellside)
// ══════════════════════════════════════════════════════════════════

C_BSL_1     = #00E676     // PDH     – bright green
C_SSL_1     = #FF1744     // PDL     – bright red
C_BSL_2     = #00BCD4     // EQH     – cyan
C_SSL_2     = #FF6F00     // EQL     – amber
C_BSL_3     = #66BB6A     // Swing H – muted green
C_SSL_3     = #EF5350     // Swing L – muted red
C_BSL_HTF   = #A5D6A7     // HTF H   – pale green
C_SSL_HTF   = #FFAB91     // HTF L   – pale salmon
C_SWEPT     = #546E7A     // swept   – blue-grey

// ══════════════════════════════════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════════════════════════════════

priceStr(p) => str.tostring(p, format.mintick)

// ══════════════════════════════════════════════════════════════════
//  FOOTPRINT  (single call — Premium)
// ══════════════════════════════════════════════════════════════════

footprint fpData = request.footprint(i_fpTicks)

float fpDelta = na
if not na(fpData)
    fpDelta := fpData.delta()

// ══════════════════════════════════════════════════════════════════
//  SECTION 1 — PDH / PDL / PWH / PWL
//  Solid thick lines with price labels at the right end.
//  Thin colored band shows the zone.
// ══════════════════════════════════════════════════════════════════

[pdH, pdL] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

newDay  = timeframe.change("D")
newWeek = timeframe.change("W")

var line  pdh_ln = na, var line  pdl_ln = na
var label pdh_lb = na, var label pdl_lb = na
var box   pdh_bx = na, var box   pdl_bx = na

var line  pwh_ln = na, var line  pwl_ln = na
var label pwh_lb = na, var label pwl_lb = na

if i_pdShow and newDay and barstate.isconfirmed
    line.delete(pdh_ln),  line.delete(pdl_ln)
    label.delete(pdh_lb), label.delete(pdl_lb)
    box.delete(pdh_bx),   box.delete(pdl_bx)

    int x1 = bar_index
    int x2 = bar_index + i_ext
    float band = pdH * 0.0004

    pdh_ln := line.new(x1, pdH, x2, pdH,
                 color=color.new(C_BSL_1, 0), width=2, style=line.style_solid)
    pdl_ln := line.new(x1, pdL, x2, pdL,
                 color=color.new(C_SSL_1, 0), width=2, style=line.style_solid)
    pdh_bx := box.new(x1, pdH + band, x2, pdH - band,
                 bgcolor=color.new(C_BSL_1, 90), border_color=na)
    pdl_bx := box.new(x1, pdL + band, x2, pdL - band,
                 bgcolor=color.new(C_SSL_1, 90), border_color=na)
    pdh_lb := label.new(x2 + 1, pdH, text="PDH  " + priceStr(pdH),
                 style=label.style_none, textcolor=color.new(C_BSL_1, 0), size=size.normal)
    pdl_lb := label.new(x2 + 1, pdL, text="PDL  " + priceStr(pdL),
                 style=label.style_none, textcolor=color.new(C_SSL_1, 0), size=size.normal)

if i_pwShow and newWeek and barstate.isconfirmed
    line.delete(pwh_ln),  line.delete(pwl_ln)
    label.delete(pwh_lb), label.delete(pwl_lb)

    int x1 = bar_index
    int x2 = bar_index + i_ext

    pwh_ln := line.new(x1, pwH, x2, pwH,
                 color=color.new(C_BSL_1, 30), width=2, style=line.style_dashed)
    pwl_ln := line.new(x1, pwL, x2, pwL,
                 color=color.new(C_SSL_1, 30), width=2, style=line.style_dashed)
    pwh_lb := label.new(x2 + 1, pwH, text="PWH  " + priceStr(pwH),
                 style=label.style_none, textcolor=color.new(C_BSL_1, 30), size=size.normal)
    pwl_lb := label.new(x2 + 1, pwL, text="PWL  " + priceStr(pwL),
                 style=label.style_none, textcolor=color.new(C_SSL_1, 30), size=size.normal)

// ══════════════════════════════════════════════════════════════════
//  SECTION 2 — SWING HIGHS / LOWS
//  Dotted lines only — no boxes, no labels (to keep chart clean).
//  These are the building blocks; labels appear only when
//  a level becomes an EQH/EQL or gets swept.
// ══════════════════════════════════════════════════════════════════

float swPH = ta.pivothigh(i_swLeft, i_swRight)
float swPL = ta.pivotlow(i_swLeft,  i_swRight)

var array<float> swh_lvl  = array.new<float>()
var array<float> swl_lvl  = array.new<float>()
var array<line>  swh_lns  = array.new<line>()
var array<line>  swl_lns  = array.new<line>()
var array<int>   swh_bars = array.new<int>()
var array<int>   swl_bars = array.new<int>()
var array<bool>  swh_swpt = array.new<bool>()
var array<bool>  swl_swpt = array.new<bool>()

if i_swShow and not na(swPH)
    if array.size(swh_lns) >= i_swMax
        line.delete(array.shift(swh_lns))
        array.shift(swh_lvl)
        array.shift(swh_bars)
        array.shift(swh_swpt)

    int x1 = bar_index - i_swRight
    int x2 = x1 + i_ext
    l = line.new(x1, swPH, x2, swPH,
            color=color.new(C_BSL_3, 50), width=1, style=line.style_dotted)
    array.push(swh_lns,  l)
    array.push(swh_lvl,  swPH)
    array.push(swh_bars, x1)
    array.push(swh_swpt, false)

if i_swShow and not na(swPL)
    if array.size(swl_lns) >= i_swMax
        line.delete(array.shift(swl_lns))
        array.shift(swl_lvl)
        array.shift(swl_bars)
        array.shift(swl_swpt)

    int x1 = bar_index - i_swRight
    int x2 = x1 + i_ext
    l = line.new(x1, swPL, x2, swPL,
            color=color.new(C_SSL_3, 50), width=1, style=line.style_dotted)
    array.push(swl_lns,  l)
    array.push(swl_lvl,  swPL)
    array.push(swl_bars, x1)
    array.push(swl_swpt, false)

// ══════════════════════════════════════════════════════════════════
//  SECTION 3 — HTF SWING LEVELS
//  Dashed line + tiny label showing timeframe and price.
//  No box — just a clean line that stands out by color.
// ══════════════════════════════════════════════════════════════════

[htfPH, htfPL] = request.security(syminfo.tickerid, i_htfTF,
     [ta.pivothigh(i_swLeft, i_swRight), ta.pivotlow(i_swLeft, i_swRight)],
     gaps=barmerge.gaps_on)

var array<line>  htfh_lns = array.new<line>()
var array<line>  htfl_lns = array.new<line>()
var array<label> htfh_lbs = array.new<label>()
var array<label> htfl_lbs = array.new<label>()

if i_htfShow and not na(htfPH)
    if array.size(htfh_lns) >= i_swMax
        line.delete(array.shift(htfh_lns))
        label.delete(array.shift(htfh_lbs))

    int x2 = bar_index + i_ext
    l  = line.new(bar_index, htfPH, x2, htfPH,
             color=color.new(C_BSL_HTF, 0), width=1, style=line.style_dashed)
    lb = label.new(x2 + 1, htfPH,
             text=i_htfTF + " H  " + priceStr(htfPH),
             style=label.style_none, textcolor=color.new(C_BSL_HTF, 0), size=size.small)
    array.push(htfh_lns, l)
    array.push(htfh_lbs, lb)

if i_htfShow and not na(htfPL)
    if array.size(htfl_lns) >= i_swMax
        line.delete(array.shift(htfl_lns))
        label.delete(array.shift(htfl_lbs))

    int x2 = bar_index + i_ext
    l  = line.new(bar_index, htfPL, x2, htfPL,
             color=color.new(C_SSL_HTF, 0), width=1, style=line.style_dashed)
    lb = label.new(x2 + 1, htfPL,
             text=i_htfTF + " L  " + priceStr(htfPL),
             style=label.style_none, textcolor=color.new(C_SSL_HTF, 0), size=size.small)
    array.push(htfl_lns, l)
    array.push(htfl_lbs, lb)

// ══════════════════════════════════════════════════════════════════
//  SECTION 4 — EQUAL HIGHS / LOWS (EQH / EQL)
//  Dashed line at the midpoint + box spanning between the two
//  equal pivots.  Label clearly says "EQH" or "EQL" with price.
// ══════════════════════════════════════════════════════════════════

var array<line>  eqh_lns = array.new<line>()
var array<line>  eql_lns = array.new<line>()
var array<box>   eqh_bxs = array.new<box>()
var array<box>   eql_bxs = array.new<box>()
var array<label> eqh_lbs = array.new<label>()
var array<label> eql_lbs = array.new<label>()

float eqFrac = i_eqTol / 100.0

if i_eqShow and not na(swPH)
    sz = array.size(swh_lvl)
    if sz >= 2
        prevH = array.get(swh_lvl, sz - 2)
        if math.abs(swPH - prevH) / prevH <= eqFrac
            if array.size(eqh_lns) >= 8
                line.delete(array.shift(eqh_lns))
                box.delete(array.shift(eqh_bxs))
                label.delete(array.shift(eqh_lbs))

            float hi  = math.max(swPH, prevH)
            float lo  = math.min(swPH, prevH)
            float mid = (hi + lo) / 2.0
            int x1    = bar_index - i_swRight
            int x2    = x1 + i_ext

            l  = line.new(x1, mid, x2, mid,
                     color=color.new(C_BSL_2, 0), width=2, style=line.style_dashed)
            b  = box.new(x1, hi, x2, lo,
                     bgcolor=color.new(C_BSL_2, 88), border_color=color.new(C_BSL_2, 60),
                     border_width=1)
            lb = label.new(x2 + 1, mid, text="EQH  " + priceStr(mid),
                     style=label.style_none, textcolor=color.new(C_BSL_2, 0), size=size.normal)
            array.push(eqh_lns, l)
            array.push(eqh_bxs, b)
            array.push(eqh_lbs, lb)

if i_eqShow and not na(swPL)
    sz = array.size(swl_lvl)
    if sz >= 2
        prevL = array.get(swl_lvl, sz - 2)
        if math.abs(swPL - prevL) / prevL <= eqFrac
            if array.size(eql_lns) >= 8
                line.delete(array.shift(eql_lns))
                box.delete(array.shift(eql_bxs))
                label.delete(array.shift(eql_lbs))

            float hi  = math.max(swPL, prevL)
            float lo  = math.min(swPL, prevL)
            float mid = (hi + lo) / 2.0
            int x1    = bar_index - i_swRight
            int x2    = x1 + i_ext

            l  = line.new(x1, mid, x2, mid,
                     color=color.new(C_SSL_2, 0), width=2, style=line.style_dashed)
            b  = box.new(x1, hi, x2, lo,
                     bgcolor=color.new(C_SSL_2, 88), border_color=color.new(C_SSL_2, 60),
                     border_width=1)
            lb = label.new(x2 + 1, mid, text="EQL  " + priceStr(mid),
                     style=label.style_none, textcolor=color.new(C_SSL_2, 0), size=size.normal)
            array.push(eql_lns, l)
            array.push(eql_bxs, b)
            array.push(eql_lbs, lb)

// ══════════════════════════════════════════════════════════════════
//  SECTION 5 — SWEPT ZONES
//  When close breaks through a swing level, the line turns grey
//  and a small "x" marker appears at the sweep bar.
// ══════════════════════════════════════════════════════════════════

if i_swept
    swh_sz = array.size(swh_lns)
    if swh_sz > 0
        for iH = 0 to swh_sz - 1
            if not array.get(swh_swpt, iH)
                lvl = array.get(swh_lvl, iH)
                if close > lvl
                    array.set(swh_swpt, iH, true)
                    line.set_color(array.get(swh_lns, iH), color.new(C_SWEPT, 70))

    swl_sz = array.size(swl_lns)
    if swl_sz > 0
        for iL = 0 to swl_sz - 1
            if not array.get(swl_swpt, iL)
                lvl = array.get(swl_lvl, iL)
                if close < lvl
                    array.set(swl_swpt, iL, true)
                    line.set_color(array.get(swl_lns, iL), color.new(C_SWEPT, 70))

// ══════════════════════════════════════════════════════════════════
//  SECTION 6 — FOOTPRINT DELTA  (off by default)
//  Shows volume delta ONCE per active level, only at the right edge
//  of the nearest swing line.  Green = buyers aggressive, red = sellers.
//  Enable in settings when you want to see order flow at key levels.
// ══════════════════════════════════════════════════════════════════

var label fpLabel = na

if i_fpShow and not na(fpDelta) and barstate.islast
    label.delete(fpLabel)

    // Find the nearest non-swept level to current close
    float nearestLvl  = na
    float nearestDist = 1.0e10

    swh_sz2 = array.size(swh_lvl)
    if swh_sz2 > 0
        for iH2 = 0 to swh_sz2 - 1
            if not array.get(swh_swpt, iH2)
                lvl  = array.get(swh_lvl, iH2)
                dist = math.abs(close - lvl)
                if dist < nearestDist
                    nearestDist := dist
                    nearestLvl  := lvl

    swl_sz2 = array.size(swl_lvl)
    if swl_sz2 > 0
        for iL2 = 0 to swl_sz2 - 1
            if not array.get(swl_swpt, iL2)
                lvl  = array.get(swl_lvl, iL2)
                dist = math.abs(close - lvl)
                if dist < nearestDist
                    nearestDist := dist
                    nearestLvl  := lvl

    // Show delta only if price is within 0.5% of the nearest level
    if not na(nearestLvl) and nearestDist / nearestLvl < 0.005
        dSign = fpDelta >= 0 ? "+" : ""
        dText = "Vol Δ " + dSign + str.tostring(math.round(fpDelta))
        dCol  = fpDelta >= 0 ? color.new(C_BSL_1, 20) : color.new(C_SSL_1, 20)
        fpLabel := label.new(bar_index + 2, nearestLvl, text=dText,
             style=label.style_none, textcolor=dCol, size=size.small)

// ══════════════════════════════════════════════════════════════════
//  LEGEND  (compact table, top-right)
// ══════════════════════════════════════════════════════════════════

var table leg = table.new(position.top_right, 1, 5,
     bgcolor=color.new(#1B2631, 15), border_width=0,
     frame_color=color.new(#455A64, 0), frame_width=1)

if barstate.islastconfirmedhistory
    table.cell(leg, 0, 0, "  LIQUIDITY MAP  ",
         text_color=#ECEFF1, text_size=size.small, bgcolor=#1B2631)

    table.cell(leg, 0, 1, "━━  PDH / PDL",
         text_color=color.new(C_BSL_1, 0), text_size=size.tiny)

    table.cell(leg, 0, 2, "╍╍  EQH / EQL",
         text_color=color.new(C_BSL_2, 0), text_size=size.tiny)

    table.cell(leg, 0, 3, "- -  HTF  (" + i_htfTF + ")",
         text_color=color.new(C_BSL_HTF, 0), text_size=size.tiny)

    table.cell(leg, 0, 4, "···  Swing H / L",
         text_color=color.new(C_BSL_3, 0), text_size=size.tiny)
