//@version=6
indicator("ICT Liquidity Map", shorttitle="ICT Liq", overlay=true,
     max_lines_count=300, max_boxes_count=200, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════

grpSW   = "▸ Swing Highs / Lows"
i_swLeft  = input.int(5,    "Left Bars",             minval=1, maxval=20,  group=grpSW)
i_swRight = input.int(5,    "Right Bars",            minval=1, maxval=20,  group=grpSW)
i_swShow  = input.bool(true, "Show Swing Levels",                          group=grpSW)
i_swMax   = input.int(6,    "Max Levels on Chart",   minval=2, maxval=20,  group=grpSW)

grpEQ   = "▸ Equal Highs / Lows  (EQH / EQL)"
i_eqShow  = input.bool(true,  "Show EQH / EQL",                           group=grpEQ)
i_eqTol   = input.float(0.05, "Tolerance (%)",  minval=0.01, maxval=0.5,  group=grpEQ, step=0.01)

grpPD   = "▸ Previous Sessions"
i_pdShow  = input.bool(true,  "Show PDH / PDL  (Previous Day)",           group=grpPD)
i_pwShow  = input.bool(false, "Show PWH / PWL  (Previous Week)",          group=grpPD)

grpHTF  = "▸ Higher Timeframe Swings"
i_htfShow = input.bool(true,         "Show HTF Swing Levels",             group=grpHTF)
i_htfTF   = input.timeframe("60",    "HTF Timeframe",                     group=grpHTF)

grpFP   = "▸ Footprint Delta  (Premium)"
i_fpShow  = input.bool(true, "Show Volume Δ at Levels",                   group=grpFP)
i_fpTicks = input.int(4,     "Ticks Per Row",        minval=1,            group=grpFP)

grpVis  = "▸ Visual Settings"
i_ext     = input.int(50,    "Extend Right (bars)",  minval=5, maxval=500, group=grpVis)
i_boxPct  = input.float(0.08,"Zone Height (%)",  minval=0.01, maxval=1.0, group=grpVis, step=0.01)
i_swept   = input.bool(true, "Mark Swept Zones",                          group=grpVis)

// ══════════════════════════════════════════════════════════════════
//  COLOR SYSTEM  —  3-tier visual priority
//  BSL = green family  |  SSL = red/amber family
//  Tier 1 (PDH/PDL) : brightest, solid, width 2
//  Tier 2 (EQH/EQL) : medium,   dashed, width 1
//  Tier 3 (Swing)   : softest,  dotted, width 1
//  HTF              : pale,     dashed, width 1
//  Swept            : grey-blue, dotted
// ══════════════════════════════════════════════════════════════════

// Tier 1
C_T1_BSL    = #00E676   // neon green
C_T1_SSL    = #FF1744   // neon red

// Tier 2
C_T2_BSL    = #00BCD4   // cyan
C_T2_SSL    = #FF6F00   // amber

// Tier 3
C_T3_BSL    = #69F0AE   // soft green
C_T3_SSL    = #FF8A80   // soft red

// HTF
C_HTF_BSL   = #B9F6CA   // pale green
C_HTF_SSL   = #FFCCBC   // pale peach

// Swept
C_SWEPT     = #607D8B   // blue-grey

// ══════════════════════════════════════════════════════════════════
//  HELPER — zone height in price units
// ══════════════════════════════════════════════════════════════════
zoneH(price) => price * i_boxPct / 100.0

// ══════════════════════════════════════════════════════════════════
//  FOOTPRINT  (single unconditional call – Premium required)
//  Data is used only when i_fpShow = true
// ══════════════════════════════════════════════════════════════════
footprint fpData  = request.footprint(i_fpTicks)

float fpDelta = na
float fpBuy   = na
float fpSell  = na
if not na(fpData)
    fpDelta := fpData.delta()
    fpBuy   := fpData.buy_volume()
    fpSell  := fpData.sell_volume()

// ══════════════════════════════════════════════════════════════════
//  PREVIOUS DAY / WEEK  H & L
// ══════════════════════════════════════════════════════════════════
[pdH, pdL] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

[pwH, pwL] = request.security(syminfo.tickerid, "W",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

newDay  = timeframe.change("D")
newWeek = timeframe.change("W")

// Persistent drawing IDs for session levels (deleted & redrawn each period)
var line  pdh_l  = na
var line  pdl_l  = na
var box   pdh_b  = na
var box   pdl_b  = na
var label pdh_lb = na
var label pdl_lb = na

var line  pwh_l  = na
var line  pwl_l  = na
var box   pwh_b  = na
var box   pwl_b  = na

if i_pdShow and newDay and barstate.isconfirmed
    line.delete(pdh_l),   line.delete(pdl_l)
    box.delete(pdh_b),    box.delete(pdl_b)
    label.delete(pdh_lb), label.delete(pdl_lb)

    h1 = zoneH(pdH)
    h2 = zoneH(pdL)
    r  = bar_index + i_ext

    pdh_l  := line.new(bar_index, pdH, r, pdH,
                 color=color.new(C_T1_BSL, 0), width=2, style=line.style_solid)
    pdl_l  := line.new(bar_index, pdL, r, pdL,
                 color=color.new(C_T1_SSL, 0), width=2, style=line.style_solid)
    pdh_b  := box.new(bar_index, pdH + h1, r, pdH - h1,
                 bgcolor=color.new(C_T1_BSL, 82), border_color=color.new(C_T1_BSL, 0), border_width=1)
    pdl_b  := box.new(bar_index, pdL + h2, r, pdL - h2,
                 bgcolor=color.new(C_T1_SSL, 82), border_color=color.new(C_T1_SSL, 0), border_width=1)
    pdh_lb := label.new(r, pdH, text=" PDH  ▲ BSL",
                 color=color.new(color.black, 100), textcolor=color.new(C_T1_BSL, 0),
                 style=label.style_label_left, size=size.small)
    pdl_lb := label.new(r, pdL, text=" PDL  ▼ SSL",
                 color=color.new(color.black, 100), textcolor=color.new(C_T1_SSL, 0),
                 style=label.style_label_left, size=size.small)

if i_pwShow and newWeek and barstate.isconfirmed
    line.delete(pwh_l), line.delete(pwl_l)
    box.delete(pwh_b),  box.delete(pwl_b)

    hw = zoneH(pwH)
    lw = zoneH(pwL)
    r  = bar_index + i_ext

    pwh_l := line.new(bar_index, pwH, r, pwH,
                color=color.new(C_T1_BSL, 20), width=2, style=line.style_dashed)
    pwl_l := line.new(bar_index, pwL, r, pwL,
                color=color.new(C_T1_SSL, 20), width=2, style=line.style_dashed)
    pwh_b := box.new(bar_index, pwH + hw, r, pwH - hw,
                bgcolor=color.new(C_T1_BSL, 87), border_color=color.new(C_T1_BSL, 20))
    pwl_b := box.new(bar_index, pwL + lw, r, pwL - lw,
                bgcolor=color.new(C_T1_SSL, 87), border_color=color.new(C_T1_SSL, 20))

// ══════════════════════════════════════════════════════════════════
//  SWING HIGHS / LOWS  (current TF — Tier 3)
// ══════════════════════════════════════════════════════════════════
float swPH = ta.pivothigh(i_swLeft, i_swRight)
float swPL = ta.pivotlow(i_swLeft,  i_swRight)

// Arrays store the N most recent levels + their drawing objects
var array<float> swh_lvl  = array.new<float>()
var array<float> swl_lvl  = array.new<float>()
var array<line>  swh_lns  = array.new<line>()
var array<line>  swl_lns  = array.new<line>()
var array<box>   swh_bxs  = array.new<box>()
var array<box>   swl_bxs  = array.new<box>()
var array<bool>  swh_swpt = array.new<bool>()
var array<bool>  swl_swpt = array.new<bool>()

if i_swShow and not na(swPH)
    // Remove oldest entry if at capacity
    if array.size(swh_lns) >= i_swMax
        line.delete(array.shift(swh_lns))
        box.delete(array.shift(swh_bxs))
        array.shift(swh_lvl)
        array.shift(swh_swpt)

    h  = zoneH(swPH)
    x1 = bar_index - i_swRight
    x2 = x1 + i_ext
    l  = line.new(x1, swPH, x2, swPH,
             color=color.new(C_T3_BSL, 0), width=1, style=line.style_dotted)
    b  = box.new(x1, swPH + h, x2, swPH - h,
             bgcolor=color.new(C_T3_BSL, 90), border_color=color.new(C_T3_BSL, 0))
    array.push(swh_lns,  l)
    array.push(swh_bxs,  b)
    array.push(swh_lvl,  swPH)
    array.push(swh_swpt, false)

if i_swShow and not na(swPL)
    if array.size(swl_lns) >= i_swMax
        line.delete(array.shift(swl_lns))
        box.delete(array.shift(swl_bxs))
        array.shift(swl_lvl)
        array.shift(swl_swpt)

    h  = zoneH(swPL)
    x1 = bar_index - i_swRight
    x2 = x1 + i_ext
    l  = line.new(x1, swPL, x2, swPL,
             color=color.new(C_T3_SSL, 0), width=1, style=line.style_dotted)
    b  = box.new(x1, swPL + h, x2, swPL - h,
             bgcolor=color.new(C_T3_SSL, 90), border_color=color.new(C_T3_SSL, 0))
    array.push(swl_lns,  l)
    array.push(swl_bxs,  b)
    array.push(swl_lvl,  swPL)
    array.push(swl_swpt, false)

// ══════════════════════════════════════════════════════════════════
//  HTF SWING HIGHS / LOWS  (pale dashed — between Tier 2 & 3)
// ══════════════════════════════════════════════════════════════════
[htfPH, htfPL] = request.security(syminfo.tickerid, i_htfTF,
     [ta.pivothigh(i_swLeft, i_swRight), ta.pivotlow(i_swLeft, i_swRight)],
     gaps=barmerge.gaps_on)

var array<line> htfh_lns = array.new<line>()
var array<line> htfl_lns = array.new<line>()
var array<box>  htfh_bxs = array.new<box>()
var array<box>  htfl_bxs = array.new<box>()

if i_htfShow and not na(htfPH)
    if array.size(htfh_lns) >= i_swMax
        line.delete(array.shift(htfh_lns))
        box.delete(array.shift(htfh_bxs))
    h  = zoneH(htfPH)
    r  = bar_index + i_ext
    l  = line.new(bar_index, htfPH, r, htfPH,
             color=color.new(C_HTF_BSL, 0), width=1, style=line.style_dashed)
    b  = box.new(bar_index, htfPH + h, r, htfPH - h,
             bgcolor=color.new(C_HTF_BSL, 88), border_color=color.new(C_HTF_BSL, 0))
    array.push(htfh_lns, l)
    array.push(htfh_bxs, b)

if i_htfShow and not na(htfPL)
    if array.size(htfl_lns) >= i_swMax
        line.delete(array.shift(htfl_lns))
        box.delete(array.shift(htfl_bxs))
    h  = zoneH(htfPL)
    r  = bar_index + i_ext
    l  = line.new(bar_index, htfPL, r, htfPL,
             color=color.new(C_HTF_SSL, 0), width=1, style=line.style_dashed)
    b  = box.new(bar_index, htfPL + h, r, htfPL - h,
             bgcolor=color.new(C_HTF_SSL, 88), border_color=color.new(C_HTF_SSL, 0))
    array.push(htfl_lns, l)
    array.push(htfl_bxs, b)

// ══════════════════════════════════════════════════════════════════
//  EQUAL HIGHS / LOWS  (Tier 2 — cyan / amber)
//  Detected when two consecutive pivot highs/lows are within tolerance
// ══════════════════════════════════════════════════════════════════
var array<line>  eqh_lns = array.new<line>()
var array<line>  eql_lns = array.new<line>()
var array<box>   eqh_bxs = array.new<box>()
var array<box>   eql_bxs = array.new<box>()
var array<label> eqh_lbs = array.new<label>()
var array<label> eql_lbs = array.new<label>()

float eqFrac = i_eqTol / 100.0

if i_eqShow and not na(swPH)
    sz = array.size(swh_lvl)
    if sz >= 2
        prevH = array.get(swh_lvl, sz - 2)
        if math.abs(swPH - prevH) / prevH <= eqFrac
            // Prune oldest EQH
            if array.size(eqh_lns) >= 10
                line.delete(array.shift(eqh_lns))
                box.delete(array.shift(eqh_bxs))
                label.delete(array.shift(eqh_lbs))
            h  = zoneH(swPH)
            x1 = bar_index - i_swRight
            x2 = x1 + i_ext
            l  = line.new(x1, swPH, x2, swPH,
                     color=color.new(C_T2_BSL, 0), width=1, style=line.style_dashed)
            b  = box.new(x1, swPH + h, x2, swPH - h,
                     bgcolor=color.new(C_T2_BSL, 84), border_color=color.new(C_T2_BSL, 0))
            lb = label.new(x2, swPH, text=" EQH  ▲ BSL",
                     color=color.new(color.black, 100), textcolor=color.new(C_T2_BSL, 0),
                     style=label.style_label_left, size=size.small)
            array.push(eqh_lns, l)
            array.push(eqh_bxs, b)
            array.push(eqh_lbs, lb)

if i_eqShow and not na(swPL)
    sz = array.size(swl_lvl)
    if sz >= 2
        prevL = array.get(swl_lvl, sz - 2)
        if math.abs(swPL - prevL) / prevL <= eqFrac
            if array.size(eql_lns) >= 10
                line.delete(array.shift(eql_lns))
                box.delete(array.shift(eql_bxs))
                label.delete(array.shift(eql_lbs))
            h  = zoneH(swPL)
            x1 = bar_index - i_swRight
            x2 = x1 + i_ext
            l  = line.new(x1, swPL, x2, swPL,
                     color=color.new(C_T2_SSL, 0), width=1, style=line.style_dashed)
            b  = box.new(x1, swPL + h, x2, swPL - h,
                     bgcolor=color.new(C_T2_SSL, 84), border_color=color.new(C_T2_SSL, 0))
            lb = label.new(x2, swPL, text=" EQL  ▼ SSL",
                     color=color.new(color.black, 100), textcolor=color.new(C_T2_SSL, 0),
                     style=label.style_label_left, size=size.small)
            array.push(eql_lns, l)
            array.push(eql_bxs, b)
            array.push(eql_lbs, lb)

// ══════════════════════════════════════════════════════════════════
//  SWEPT ZONES
//  When price closes through a swing level → grey it out
// ══════════════════════════════════════════════════════════════════
if i_swept
    // Swing highs swept when close > level (stop hunt above BSL)
    swh_sz = array.size(swh_lns)
    if swh_sz > 0
        for iH = 0 to swh_sz - 1
            if not array.get(swh_swpt, iH)
                lvl = array.get(swh_lvl, iH)
                if close > lvl
                    array.set(swh_swpt, iH, true)
                    line.set_color(array.get(swh_lns, iH), color.new(C_SWEPT, 30))
                    line.set_style(array.get(swh_lns, iH), line.style_dotted)
                    box.set_bgcolor(array.get(swh_bxs, iH), color.new(C_SWEPT, 93))
                    box.set_border_color(array.get(swh_bxs, iH), color.new(C_SWEPT, 60))

    // Swing lows swept when close < level
    swl_sz = array.size(swl_lns)
    if swl_sz > 0
        for iL = 0 to swl_sz - 1
            if not array.get(swl_swpt, iL)
                lvl = array.get(swl_lvl, iL)
                if close < lvl
                    array.set(swl_swpt, iL, true)
                    line.set_color(array.get(swl_lns, iL), color.new(C_SWEPT, 30))
                    line.set_style(array.get(swl_lns, iL), line.style_dotted)
                    box.set_bgcolor(array.get(swl_bxs, iL), color.new(C_SWEPT, 93))
                    box.set_border_color(array.get(swl_bxs, iL), color.new(C_SWEPT, 60))

// ══════════════════════════════════════════════════════════════════
//  FOOTPRINT DELTA LABELS
//  Shows Volume Δ when price is within 0.2% of any swing level
//  ▲Δ (green) = more buy aggression  |  ▼Δ (red) = more sell aggression
// ══════════════════════════════════════════════════════════════════
if i_fpShow and not na(fpDelta) and barstate.isconfirmed
    proximity = 0.002   // 0.2% threshold

    for i = 0 to array.size(swh_lvl) - 1
        lvl = array.get(swh_lvl, i)
        if math.abs(close - lvl) / lvl < proximity
            dStr = (fpDelta >= 0 ? "▲Δ +" : "▼Δ ") + str.tostring(math.round(fpDelta), "#,##0")
            dCol = fpDelta >= 0 ? color.new(C_T1_BSL, 0) : color.new(C_T1_SSL, 0)
            label.new(bar_index, lvl,
                 text=dStr, color=color.new(#1E2124, 15),
                 textcolor=dCol, style=label.style_label_lower_right, size=size.tiny)

    for i = 0 to array.size(swl_lvl) - 1
        lvl = array.get(swl_lvl, i)
        if math.abs(close - lvl) / lvl < proximity
            dStr = (fpDelta >= 0 ? "▲Δ +" : "▼Δ ") + str.tostring(math.round(fpDelta), "#,##0")
            dCol = fpDelta >= 0 ? color.new(C_T1_BSL, 0) : color.new(C_T1_SSL, 0)
            label.new(bar_index, lvl,
                 text=dStr, color=color.new(#1E2124, 15),
                 textcolor=dCol, style=label.style_label_upper_right, size=size.tiny)

// ══════════════════════════════════════════════════════════════════
//  LEGEND TABLE  (top-right corner)
// ══════════════════════════════════════════════════════════════════
var table legend = table.new(position.top_right, 2, 8,
     bgcolor=color.new(#1E2124, 10),
     border_color=color.new(#455A64, 0), border_width=1,
     frame_color=color.new(#455A64, 0),  frame_width=1)

if barstate.islastconfirmedhistory
    // Title row
    table.cell(legend, 0, 0, "  ICT  LIQUIDITY  MAP  ",
         text_color=#CFD8DC, text_size=size.small,
         bgcolor=#263238, text_halign=text.align_center)
    table.merge_cells(legend, 0, 0, 1, 0)

    // BSL header
    table.cell(legend, 0, 1, "▲ BUYSIDE (BSL)",
         text_color=color.new(C_T1_BSL, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 1, "▼ SELLSIDE (SSL)",
         text_color=color.new(C_T1_SSL, 0), text_size=size.tiny, text_halign=text.align_left)

    // Tier 1
    table.cell(legend, 0, 2, "● PDH / PWH",
         text_color=color.new(C_T1_BSL, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 2, "  Tier 1 · solid · w2",
         text_color=#90A4AE, text_size=size.tiny, text_halign=text.align_left)

    // Tier 2
    table.cell(legend, 0, 3, "● EQH",
         text_color=color.new(C_T2_BSL, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 3, "  Tier 2 · dashed · w1",
         text_color=#90A4AE, text_size=size.tiny, text_halign=text.align_left)

    // HTF
    table.cell(legend, 0, 4, "● HTF Swing",
         text_color=color.new(C_HTF_BSL, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 4, "  HTF  · dashed · w1",
         text_color=#90A4AE, text_size=size.tiny, text_halign=text.align_left)

    // Tier 3
    table.cell(legend, 0, 5, "● Swing H/L",
         text_color=color.new(C_T3_BSL, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 5, "  Tier 3 · dotted · w1",
         text_color=#90A4AE, text_size=size.tiny, text_halign=text.align_left)

    // Swept
    table.cell(legend, 0, 6, "● Swept",
         text_color=color.new(C_SWEPT, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 6, "  Liquidity taken",
         text_color=#90A4AE, text_size=size.tiny, text_halign=text.align_left)

    // Footprint row
    fpStatus = i_fpShow ? "ON" : "OFF"
    table.cell(legend, 0, 7, "▲Δ / ▼Δ  FP: " + fpStatus,
         text_color=color.new(C_T2_BSL, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 7, "  Vol delta @ level",
         text_color=#90A4AE, text_size=size.tiny, text_halign=text.align_left)
