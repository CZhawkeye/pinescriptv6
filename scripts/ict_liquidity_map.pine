//@version=6
indicator("ICT Liquidity Zones", shorttitle="ICT Liq", overlay=true,
     max_lines_count=200, max_boxes_count=200, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════
//  INPUTS
// ══════════════════════════════════════════════════════════════════

grpSW  = "Swing Structure"
i_swL  = input.int(5,    "Left Bars",          minval=1, maxval=20,  group=grpSW)
i_swR  = input.int(5,    "Right Bars",         minval=1, maxval=20,  group=grpSW)
i_swN    = input.int(4,    "Max Levels per Side",minval=2, maxval=12,  group=grpSW)
i_strOn  = input.bool(true,  "Detect Strong Pivots",                            group=grpSW)
i_strAtr = input.float(1.2,  "  Min Impulse (×ATR)", minval=0.5, maxval=3.0, step=0.1,  group=grpSW)
i_strBdy = input.float(0.55, "  Min Body Ratio",     minval=0.2, maxval=0.9, step=0.05, group=grpSW)

grpEQ  = "Equal Highs / Lows"
i_eqOn = input.bool(true,  "Detect EQH / EQL",                      group=grpEQ)
i_eqTol= input.float(0.05, "Tolerance (%)", minval=0.01, maxval=0.5,group=grpEQ, step=0.01)

grpPD  = "Session Levels"
i_pdOn = input.bool(true,  "Show PDH / PDL",                        group=grpPD)
i_pwOn = input.bool(false, "Show PWH / PWL",                        group=grpPD)

grpHTF = "Higher Timeframe"
i_htfOn= input.bool(true,       "Show HTF Swings",                  group=grpHTF)
i_htfTF= input.timeframe("60",  "Timeframe",                        group=grpHTF)

grpFP  = "Footprint (Premium)"
// Footprint acts as a secondary scoring layer on top of structural zones.
// It does NOT create new zones — instead it highlights swing/session levels
// where order flow (delta + imbalances) confirms liquidity accumulation.
i_fpOn = input.bool(true,  "Score Zones with Footprint",            group=grpFP)
i_fpT  = input.int(4,      "Ticks Per Row",     minval=1,           group=grpFP)
i_fvThr= input.float(1.0,  "FP Confirmation Threshold (× avg delta)",minval=0.5, maxval=8.0, group=grpFP, step=0.5)
i_absOn = input.bool(true,  "Mark Absorption Sweeps",               group=grpFP)
i_absThr= input.float(0.5,  "Absorption Delta (× avg δ)",  minval=0.1, maxval=3.0, step=0.1, group=grpFP)
i_absWin= input.int(5,      "Absorption Window (bars)",    minval=1, maxval=15,              group=grpFP)

grpZones = "Zones"
// Each row: color  text  style  width  (style/width apply to both sides of the pair)
i_bslCol  = input.color(#00E676,  "BSL",   group=grpZones, inline="bsl")
i_bslTxt  = input.string("BSL",   "",      group=grpZones, inline="bsl")
i_swSty   = input.string("dotted","",      options=["solid","dashed","dotted"], group=grpZones, inline="bsl")
i_swW     = input.int(1,          "",      minval=1, maxval=4, group=grpZones, inline="bsl")

i_sslCol  = input.color(#FF1744,  "SSL",   group=grpZones, inline="ssl")
i_sslTxt  = input.string("SSL",   "",      group=grpZones, inline="ssl")

i_eqhCol  = input.color(#00BCD4,  "EQH",  group=grpZones, inline="eqh")
i_eqhTxt  = input.string("EQH",   "",      group=grpZones, inline="eqh")
i_eqSty   = input.string("dashed","",      options=["solid","dashed","dotted"], group=grpZones, inline="eqh")
i_eqW     = input.int(2,          "",      minval=1, maxval=4, group=grpZones, inline="eqh")

i_eqlCol  = input.color(#FF6F00,  "EQL",  group=grpZones, inline="eql")
i_eqlTxt  = input.string("EQL",   "",      group=grpZones, inline="eql")

i_pdhCol  = input.color(#00E676,  "PDH",  group=grpZones, inline="pdh")
i_pdhTxt  = input.string("PDH",   "",      group=grpZones, inline="pdh")
i_pdSty   = input.string("solid", "",      options=["solid","dashed","dotted"], group=grpZones, inline="pdh")
i_pdW     = input.int(2,          "",      minval=1, maxval=4, group=grpZones, inline="pdh")

i_pdlCol  = input.color(#FF1744,  "PDL",  group=grpZones, inline="pdl")
i_pdlTxt  = input.string("PDL",   "",      group=grpZones, inline="pdl")

i_pwhCol  = input.color(#00E676,  "PWH",  group=grpZones, inline="pwh")
i_pwhTxt  = input.string("PWH",   "",      group=grpZones, inline="pwh")

i_pwlCol  = input.color(#FF1744,  "PWL",  group=grpZones, inline="pwl")
i_pwlTxt  = input.string("PWL",   "",      group=grpZones, inline="pwl")

i_htfHC   = input.color(#A5D6A7,  "HTF H",group=grpZones, inline="htfh")
i_htfHTxt = input.string("H",     "",      group=grpZones, inline="htfh")
i_htfSty  = input.string("dashed","",      options=["solid","dashed","dotted"], group=grpZones, inline="htfh")
i_htfW    = input.int(1,          "",      minval=1, maxval=4, group=grpZones, inline="htfh")

i_htfLC   = input.color(#FFAB91,  "HTF L",group=grpZones, inline="htfl")
i_htfLTxt = input.string("L",     "",      group=grpZones, inline="htfl")

i_magCol  = input.color(#FFD600,  "Magnet",group=grpZones, inline="mag")
i_fvCol   = input.color(#B388FF,  "FP",    group=grpZones, inline="fp")

grpVis = "Visual"
i_ext    = input.int(30, "Extend Right (bars)", minval=5,  maxval=200, group=grpVis)
i_zTicks = input.int(3,  "Zone Height (ticks)", minval=1,  maxval=20,  group=grpVis)

// ══════════════════════════════════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════════════════════════════════

priceStr(p) => str.tostring(p, format.mintick)
zoneH(_p)   => float(syminfo.mintick * i_zTicks)

styleOf(s) =>
    s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid

// Search back to find the bar where price matches a level
findBar(target, useHigh) =>
    int found = bar_index
    float tol = syminfo.mintick * 3
    for lb = 1 to 500
        float val = useHigh ? high[lb] : low[lb]
        if math.abs(val - target) <= tol
            found := bar_index - lb
            break
    found

// ══════════════════════════════════════════════════════════════════
//  FOOTPRINT
// ══════════════════════════════════════════════════════════════════

footprint fpData = request.footprint(i_fpT)
float fpDelta    = not na(fpData) ? fpData.delta() : na

// Rolling average |delta| — window of last 50 bars, current bar excluded
// so a bar cannot inflate its own threshold
var array<float> fpWindow = array.new<float>()

if not na(fpDelta[1])
    if array.size(fpWindow) >= 50
        array.shift(fpWindow)
    array.push(fpWindow, math.abs(fpDelta[1]))

float fpAvgAbs = array.size(fpWindow) >= 20 ? array.avg(fpWindow) : na

// ══════════════════════════════════════════════════════════════════
//  PDH / PDL — start at the candle that formed the high/low
// ══════════════════════════════════════════════════════════════════

[pdH, pdL] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, "W",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

newDay  = timeframe.change("D")
newWeek = timeframe.change("W")

var line  pdh_ln = na, var line  pdl_ln = na
var label pdh_lb = na, var label pdl_lb = na
var box   pdh_bx = na, var box   pdl_bx = na
var line  pwh_ln = na, var line  pwl_ln = na
var label pwh_lb = na, var label pwl_lb = na

if i_pdOn and newDay and barstate.isconfirmed
    line.delete(pdh_ln),  line.delete(pdl_ln)
    label.delete(pdh_lb), label.delete(pdl_lb)
    box.delete(pdh_bx),   box.delete(pdl_bx)

    int xH  = findBar(pdH, true)
    int xL  = findBar(pdL, false)
    int rH  = xH + i_ext
    int rL  = xL + i_ext
    float bH = zoneH(pdH)
    float bL = zoneH(pdL)

    pdh_ln := line.new(xH, pdH, rH, pdH,
                 color=i_pdhCol, width=i_pdW, style=styleOf(i_pdSty))
    pdl_ln := line.new(xL, pdL, rL, pdL,
                 color=i_pdlCol, width=i_pdW, style=styleOf(i_pdSty))
    pdh_bx := box.new(xH, pdH + bH, rH, pdH - bH,
                 bgcolor=color.new(i_pdhCol, 88), border_color=na)
    pdl_bx := box.new(xL, pdL + bL, rL, pdL - bL,
                 bgcolor=color.new(i_pdlCol, 88), border_color=na)
    string _pdhLbl = i_pdhTxt
    string _pdlLbl = i_pdlTxt
    pdh_lb := label.new(rH + 1, pdH, text=_pdhLbl,
                 style=label.style_none, textcolor=i_pdhCol, size=size.normal)
    pdl_lb := label.new(rL + 1, pdL, text=_pdlLbl,
                 style=label.style_none, textcolor=i_pdlCol, size=size.normal)

if i_pwOn and newWeek and barstate.isconfirmed
    line.delete(pwh_ln), line.delete(pwl_ln)
    label.delete(pwh_lb), label.delete(pwl_lb)

    int xH = findBar(pwH, true)
    int xL = findBar(pwL, false)
    int rH = xH + i_ext
    int rL = xL + i_ext

    pwh_ln := line.new(xH, pwH, rH, pwH,
                 color=i_pwhCol, width=i_pdW, style=styleOf(i_pdSty))
    pwl_ln := line.new(xL, pwL, rL, pwL,
                 color=i_pwlCol, width=i_pdW, style=styleOf(i_pdSty))
    string _pwhLbl = i_pwhTxt
    string _pwlLbl = i_pwlTxt
    pwh_lb := label.new(rH + 1, pwH, text=_pwhLbl,
                 style=label.style_none, textcolor=i_pwhCol, size=size.normal)
    pwl_lb := label.new(rL + 1, pwL, text=_pwlLbl,
                 style=label.style_none, textcolor=i_pwlCol, size=size.normal)

// ══════════════════════════════════════════════════════════════════
//  SWING LEVELS — zones where retail stops accumulate
// ══════════════════════════════════════════════════════════════════

float swPH = ta.pivothigh(i_swL, i_swR)
float swPL = ta.pivotlow(i_swL,  i_swR)

var array<float> sh_lvl  = array.new<float>()
var array<line>  sh_ln   = array.new<line>()
var array<box>   sh_bx   = array.new<box>()
var array<bool>  sh_swpt = array.new<bool>()
var array<int>   sh_tch  = array.new<int>()
var array<float> sh_fp   = array.new<float>()
var array<bool>  sh_isEQ = array.new<bool>()
var array<bool>  sh_str  = array.new<bool>()

var array<float> sl_lvl  = array.new<float>()
var array<line>  sl_ln   = array.new<line>()
var array<box>   sl_bx   = array.new<box>()
var array<bool>  sl_swpt = array.new<bool>()
var array<int>   sl_tch  = array.new<int>()
var array<float> sl_fp   = array.new<float>()
var array<bool>  sl_isEQ = array.new<bool>()
var array<bool>  sl_str  = array.new<bool>()

// Absorption sweep tracking: recently swept SSL/BSL levels + their bar_index
var array<float> slSweepLvl = array.new<float>()
var array<int>   slSweepBar = array.new<int>()
var array<float> shSweepLvl = array.new<float>()
var array<int>   shSweepBar = array.new<int>()
// Persistent absorption markers (kept for visual history, capped at 50)
var array<label> absLbls    = array.new<label>()

if not na(swPH)
    if array.size(sh_ln) >= i_swN
        line.delete(array.shift(sh_ln)), box.delete(array.shift(sh_bx))
        array.shift(sh_lvl), array.shift(sh_swpt)
        array.shift(sh_tch), array.shift(sh_fp), array.shift(sh_isEQ), array.shift(sh_str)

    int x1  = bar_index - i_swR
    int x2  = x1 + i_ext
    float h = zoneH(swPH)

    array.push(sh_ln, line.new(x1, swPH, x2, swPH,
         color=color.new(i_bslCol, 60), width=i_swW, style=styleOf(i_swSty)))
    array.push(sh_bx, box.new(x1, swPH + h, x2, swPH - h,
         bgcolor=color.new(i_bslCol, 94), border_color=na))
    array.push(sh_lvl, swPH), array.push(sh_swpt, false)
    array.push(sh_tch, 0),    array.push(sh_fp, 0.0)
    array.push(sh_isEQ, false)
    float _rng_ph = high[i_swR] - low[i_swR]
    float _bdy_ph = math.abs(close[i_swR] - open[i_swR])
    array.push(sh_str, i_strOn
         and _rng_ph > ta.atr(14) * i_strAtr
         and (_rng_ph > 0 ? _bdy_ph / _rng_ph : 0.0) > i_strBdy)

if not na(swPL)
    if array.size(sl_ln) >= i_swN
        line.delete(array.shift(sl_ln)), box.delete(array.shift(sl_bx))
        array.shift(sl_lvl), array.shift(sl_swpt)
        array.shift(sl_tch), array.shift(sl_fp), array.shift(sl_isEQ), array.shift(sl_str)

    int x1  = bar_index - i_swR
    int x2  = x1 + i_ext
    float h = zoneH(swPL)

    array.push(sl_ln, line.new(x1, swPL, x2, swPL,
         color=color.new(i_sslCol, 60), width=i_swW, style=styleOf(i_swSty)))
    array.push(sl_bx, box.new(x1, swPL + h, x2, swPL - h,
         bgcolor=color.new(i_sslCol, 94), border_color=na))
    array.push(sl_lvl, swPL), array.push(sl_swpt, false)
    array.push(sl_tch, 0),    array.push(sl_fp, 0.0)
    array.push(sl_isEQ, false)
    float _rng_pl = high[i_swR] - low[i_swR]
    float _bdy_pl = math.abs(close[i_swR] - open[i_swR])
    array.push(sl_str, i_strOn
         and _rng_pl > ta.atr(14) * i_strAtr
         and (_rng_pl > 0 ? _bdy_pl / _rng_pl : 0.0) > i_strBdy)

// ══════════════════════════════════════════════════════════════════
//  EQH / EQL — mark matching swing zones
// ══════════════════════════════════════════════════════════════════

float eqF = i_eqTol / 100.0

if i_eqOn and not na(swPH)
    sz = array.size(sh_lvl)
    if sz >= 2
        if math.abs(swPH - array.get(sh_lvl, sz - 2)) / swPH <= eqF
            array.set(sh_isEQ, sz - 1, true)
            array.set(sh_isEQ, sz - 2, true)

if i_eqOn and not na(swPL)
    sz = array.size(sl_lvl)
    if sz >= 2
        if math.abs(swPL - array.get(sl_lvl, sz - 2)) / swPL <= eqF
            array.set(sl_isEQ, sz - 1, true)
            array.set(sl_isEQ, sz - 2, true)

// ══════════════════════════════════════════════════════════════════
//  HTF SWING LEVELS — anchored to formation candle
// ══════════════════════════════════════════════════════════════════

[htfPH, htfPL] = request.security(syminfo.tickerid, i_htfTF,
     [ta.pivothigh(i_swL, i_swR), ta.pivotlow(i_swL, i_swR)],
     gaps=barmerge.gaps_on)

var array<line>  htf_ln = array.new<line>()
var array<label> htf_lb = array.new<label>()

if i_htfOn and not na(htfPH)
    if array.size(htf_ln) >= i_swN * 2
        line.delete(array.shift(htf_ln)), label.delete(array.shift(htf_lb))
    int xH = findBar(htfPH, true)
    int rH = xH + i_ext
    array.push(htf_ln, line.new(xH, htfPH, rH, htfPH,
         color=color.new(i_htfHC, 0), width=i_htfW, style=styleOf(i_htfSty)))
    string _htfHLbl = i_htfTF + (str.length(i_htfHTxt) > 0 ? " " + i_htfHTxt : "")
    array.push(htf_lb, label.new(rH + 1, htfPH,
         text=_htfHLbl,
         style=label.style_none, textcolor=color.new(i_htfHC, 0), size=size.small))

if i_htfOn and not na(htfPL)
    if array.size(htf_ln) >= i_swN * 2
        line.delete(array.shift(htf_ln)), label.delete(array.shift(htf_lb))
    int xL = findBar(htfPL, false)
    int rL = xL + i_ext
    array.push(htf_ln, line.new(xL, htfPL, rL, htfPL,
         color=color.new(i_htfLC, 0), width=i_htfW, style=styleOf(i_htfSty)))
    string _htfLLbl = i_htfTF + (str.length(i_htfLTxt) > 0 ? " " + i_htfLTxt : "")
    array.push(htf_lb, label.new(rL + 1, htfPL,
         text=_htfLLbl,
         style=label.style_none, textcolor=color.new(i_htfLC, 0), size=size.small))

// ══════════════════════════════════════════════════════════════════
//  ATR
// ══════════════════════════════════════════════════════════════════

float _atr = ta.atr(14)

// ══════════════════════════════════════════════════════════════════
//  FOOTPRINT DIRECTION — per-bar imbalance counts at key rows
//
//  Pine v6 exposes has_buy/sell_imbalance() on poc(), vah(), val().
//  We count matching rows per direction and use it to weight the
//  fp accumulation on structural zones that price touches this bar:
//    BSL (swing high / supply): sell imbalance = confirmation
//    SSL (swing low  / demand): buy  imbalance = confirmation
//  Weight = 1.0 + imbalance_count × 0.33  (max ~2× at 3 matching rows)
// ══════════════════════════════════════════════════════════════════

int _fpSellCount = 0
int _fpBuyCount  = 0

if i_fpOn and not na(fpData) and not na(fpDelta)
    volume_row _poc = fpData.poc()
    volume_row _vah = fpData.vah()
    volume_row _val = fpData.val()
    if not na(_poc) and not na(_vah) and not na(_val)
        _fpBuyCount  := (_poc.has_buy_imbalance()  ? 1 : 0) +
                        (_val.has_buy_imbalance()   ? 1 : 0) +
                        (_vah.has_buy_imbalance()   ? 1 : 0)
        _fpSellCount := (_poc.has_sell_imbalance() ? 1 : 0) +
                        (_val.has_sell_imbalance()  ? 1 : 0) +
                        (_vah.has_sell_imbalance()  ? 1 : 0)

// ══════════════════════════════════════════════════════════════════
//  PER-BAR: TOUCH SCORING + FP ACCUMULATION
//  fp weight: +0.33 per matching imbalance row (directional confirmation)
// ══════════════════════════════════════════════════════════════════

int shSz = array.size(sh_lvl)
int slSz = array.size(sl_lvl)

// Touch radius: wider than the visual zone box so that bars approaching
// the level (within ATR-scaled proximity) are counted as interactions.
// Uses max of visual zone height and 8% of ATR.
float _touchH = math.max(float(syminfo.mintick * i_zTicks), _atr * 0.08)

if shSz > 0
    for i = 0 to shSz - 1
        if not array.get(sh_swpt, i)
            lvl = array.get(sh_lvl, i)
            if low <= lvl + _touchH and high >= lvl - _touchH
                array.set(sh_tch, i, array.get(sh_tch, i) + 1)
                if i_fpOn and not na(fpDelta)
                    float w = 1.0 + _fpSellCount * 0.33  // sell imbalance confirms supply
                    array.set(sh_fp, i, array.get(sh_fp, i) + math.abs(fpDelta) * w)

if slSz > 0
    for i = 0 to slSz - 1
        if not array.get(sl_swpt, i)
            lvl = array.get(sl_lvl, i)
            if low <= lvl + _touchH and high >= lvl - _touchH
                array.set(sl_tch, i, array.get(sl_tch, i) + 1)
                if i_fpOn and not na(fpDelta)
                    float w = 1.0 + _fpBuyCount * 0.33   // buy imbalance confirms demand
                    array.set(sl_fp, i, array.get(sl_fp, i) + math.abs(fpDelta) * w)

// ══════════════════════════════════════════════════════════════════
//  SWEPT = DELETE — zone without stops is useless
// ══════════════════════════════════════════════════════════════════

if shSz > 0
    for i = 0 to shSz - 1
        if not array.get(sh_swpt, i) and close > array.get(sh_lvl, i)
            array.set(sh_swpt, i, true)
            line.delete(array.get(sh_ln, i))
            box.delete(array.get(sh_bx, i))
            if i_fpOn and i_absOn
                array.push(shSweepLvl, array.get(sh_lvl, i))
                array.push(shSweepBar, bar_index)

if slSz > 0
    for i = 0 to slSz - 1
        if not array.get(sl_swpt, i) and close < array.get(sl_lvl, i)
            array.set(sl_swpt, i, true)
            line.delete(array.get(sl_ln, i))
            box.delete(array.get(sl_bx, i))
            if i_fpOn and i_absOn
                array.push(slSweepLvl, array.get(sl_lvl, i))
                array.push(slSweepBar, bar_index)

// ══════════════════════════════════════════════════════════════════
//  ABSORPTION SWEEP DETECTION
//  SSL swept → price recovers above + positive delta  → ▲ ABS label
//  BSL swept → price recovers below + negative delta  → ▼ DIST label
// ══════════════════════════════════════════════════════════════════

if i_fpOn and i_absOn and not na(fpAvgAbs) and not na(fpDelta)
    float absThresh = fpAvgAbs * i_absThr

    // SSL absorption (bullish): swept demand level, price + delta recover
    int slSwSz = array.size(slSweepLvl)
    if slSwSz > 0
        for i = slSwSz - 1 to 0
            float sLvl = array.get(slSweepLvl, i)
            int   sBar = array.get(slSweepBar, i)
            if bar_index - sBar > i_absWin
                array.remove(slSweepLvl, i)
                array.remove(slSweepBar, i)
            else if close > sLvl and fpDelta > absThresh
                if array.size(absLbls) >= 50
                    label.delete(array.shift(absLbls))
                array.push(absLbls, label.new(bar_index, sLvl,
                     "▲ ABS",
                     color=color.new(#00E676, 10), textcolor=#000000,
                     style=label.style_label_up, size=size.small))
                array.remove(slSweepLvl, i)
                array.remove(slSweepBar, i)

    // BSL distribution (bearish): swept supply level, price + delta reject
    int shSwSz = array.size(shSweepLvl)
    if shSwSz > 0
        for i = shSwSz - 1 to 0
            float sLvl = array.get(shSweepLvl, i)
            int   sBar = array.get(shSweepBar, i)
            if bar_index - sBar > i_absWin
                array.remove(shSweepLvl, i)
                array.remove(shSweepBar, i)
            else if close < sLvl and fpDelta < -absThresh
                if array.size(absLbls) >= 50
                    label.delete(array.shift(absLbls))
                array.push(absLbls, label.new(bar_index, sLvl,
                     "▼ DIST",
                     color=color.new(#FF1744, 10), textcolor=#FFFFFF,
                     style=label.style_label_down, size=size.small))
                array.remove(shSweepLvl, i)
                array.remove(shSweepBar, i)

// ══════════════════════════════════════════════════════════════════
//  VISUAL UPDATE — score → intensity → magnet
// ══════════════════════════════════════════════════════════════════

var label magnetLbl = na
var array<label> dynLbls = array.new<label>()

if barstate.islast
    label.delete(magnetLbl)
    dlSz = array.size(dynLbls)
    if dlSz > 0
        for i = 0 to dlSz - 1
            label.delete(array.get(dynLbls, i))
    array.clear(dynLbls)

    float norm   = math.max(close * 0.01, 1.0)
    float minGap = _atr * 0.5   // minimum price gap between labels
    int   magIdH = -1
    int   magIdL = -1
    float bestH  = 0.0
    float bestL  = 0.0
    int   r      = bar_index + i_ext + 1

    // Pending label data (collected first, placed after dedup)
    array<float>  pLvl = array.new<float>()
    array<string> pTxt = array.new<string>()
    array<color>  pClr = array.new<color>()
    array<string> pSz  = array.new<string>()
    array<int>    pPri = array.new<int>()   // 10=target, 5=EQ, 3=FP confirmed, 1=regular

    // ── BSL zones ───────────────────────────────────────────────
    if shSz > 0
        for i = 0 to shSz - 1
            if not array.get(sh_swpt, i)
                isEQ  = array.get(sh_isEQ, i)
                isStr = array.get(sh_str,  i)
                tch   = array.get(sh_tch, i)
                fp    = array.get(sh_fp, i)
                lvl   = array.get(sh_lvl, i)
                ln    = array.get(sh_ln, i)
                bx    = array.get(sh_bx, i)

                score = tch + fp / norm + (isEQ ? 5.0 : 0.0) + (isStr ? 3.0 : 0.0)

                if score > bestH
                    bestH  := score
                    magIdH := i

                if isEQ
                    line.set_color(ln, color.new(i_eqhCol, 20))
                    line.set_width(ln, i_eqW)
                    line.set_style(ln, styleOf(i_eqSty))
                    box.set_bgcolor(bx, color.new(i_eqhCol, 88))
                    box.set_border_color(bx, color.new(i_eqhCol, 60))
                    array.push(pLvl, lvl)
                    string _eqhTxt = str.length(i_eqhTxt) > 0 ? i_eqhTxt : "EQH"
                    array.push(pTxt, _eqhTxt)
                    array.push(pClr, color.new(i_eqhCol, 0))
                    array.push(pSz,  size.small)
                    array.push(pPri, 5)
                else
                    bool fpConf = i_fpOn and not na(fpAvgAbs) and tch > 0 and (fp / tch) >= fpAvgAbs * i_fvThr
                    fade = math.max(70 - tch * 5, 30)
                    line.set_color(ln, color.new(i_bslCol, fade))
                    line.set_width(ln, tch >= 5 ? math.min(i_swW + 1, 4) : i_swW)
                    line.set_style(ln, tch >= 5 ? line.style_dashed : styleOf(i_swSty))
                    box.set_bgcolor(bx, color.new(i_bslCol, math.max(94 - tch, 85)))
                    if fpConf
                        box.set_border_color(bx, color.new(i_fvCol, 35))
                        array.push(pLvl, lvl)
                        array.push(pTxt, "FP")
                        array.push(pClr, color.new(i_fvCol, 0))
                        array.push(pSz,  size.tiny)
                        array.push(pPri, 3)
                    else
                        box.set_border_color(bx, na)
                        if str.length(i_bslTxt) > 0
                            array.push(pLvl, lvl)
                            array.push(pTxt, isStr ? i_bslTxt + " ★" : i_bslTxt)
                            array.push(pClr, color.new(i_bslCol, fade))
                            array.push(pSz,  size.tiny)
                            array.push(pPri, isStr ? 2 : 1)

    // ── SSL zones ───────────────────────────────────────────────
    if slSz > 0
        for i = 0 to slSz - 1
            if not array.get(sl_swpt, i)
                isEQ  = array.get(sl_isEQ, i)
                isStr = array.get(sl_str,  i)
                tch   = array.get(sl_tch, i)
                fp    = array.get(sl_fp, i)
                lvl   = array.get(sl_lvl, i)
                ln    = array.get(sl_ln, i)
                bx    = array.get(sl_bx, i)

                score = tch + fp / norm + (isEQ ? 5.0 : 0.0) + (isStr ? 3.0 : 0.0)

                if score > bestL
                    bestL  := score
                    magIdL := i

                if isEQ
                    line.set_color(ln, color.new(i_eqlCol, 20))
                    line.set_width(ln, i_eqW)
                    line.set_style(ln, styleOf(i_eqSty))
                    box.set_bgcolor(bx, color.new(i_eqlCol, 88))
                    box.set_border_color(bx, color.new(i_eqlCol, 60))
                    array.push(pLvl, lvl)
                    string _eqlTxt = str.length(i_eqlTxt) > 0 ? i_eqlTxt : "EQL"
                    array.push(pTxt, _eqlTxt)
                    array.push(pClr, color.new(i_eqlCol, 0))
                    array.push(pSz,  size.small)
                    array.push(pPri, 5)
                else
                    bool fpConf = i_fpOn and not na(fpAvgAbs) and tch > 0 and (fp / tch) >= fpAvgAbs * i_fvThr
                    fade = math.max(70 - tch * 5, 30)
                    line.set_color(ln, color.new(i_sslCol, fade))
                    line.set_width(ln, tch >= 5 ? math.min(i_swW + 1, 4) : i_swW)
                    line.set_style(ln, tch >= 5 ? line.style_dashed : styleOf(i_swSty))
                    box.set_bgcolor(bx, color.new(i_sslCol, math.max(94 - tch, 85)))
                    if fpConf
                        box.set_border_color(bx, color.new(i_fvCol, 35))
                        array.push(pLvl, lvl)
                        array.push(pTxt, "FP")
                        array.push(pClr, color.new(i_fvCol, 0))
                        array.push(pSz,  size.tiny)
                        array.push(pPri, 3)
                    else
                        box.set_border_color(bx, na)
                        if str.length(i_sslTxt) > 0
                            array.push(pLvl, lvl)
                            array.push(pTxt, isStr ? i_sslTxt + " ★" : i_sslTxt)
                            array.push(pClr, color.new(i_sslCol, fade))
                            array.push(pSz,  size.tiny)
                            array.push(pPri, isStr ? 2 : 1)

    // ── Apply MAGNET to strongest zone per side ─────────────────
    string _bslLbl = str.length(i_bslTxt) > 0 ? i_bslTxt : "BSL"
    string _sslLbl = str.length(i_sslTxt) > 0 ? i_sslTxt : "SSL"

    if magIdH >= 0
        line.set_color(array.get(sh_ln, magIdH), color.new(i_magCol, 0))
        line.set_width(array.get(sh_ln, magIdH), math.max(2, i_swW))
        line.set_style(array.get(sh_ln, magIdH), line.style_solid)
        box.set_bgcolor(array.get(sh_bx, magIdH), color.new(i_magCol, 85))
        box.set_border_color(array.get(sh_bx, magIdH), color.new(i_magCol, 40))
        array.push(pLvl, array.get(sh_lvl, magIdH))
        array.push(pTxt, array.get(sh_str, magIdH) ? "◆ " + _bslLbl + " ★" : "◆ " + _bslLbl)
        array.push(pClr, color.new(i_magCol, 0))
        array.push(pSz,  size.normal)
        array.push(pPri, 10)

    if magIdL >= 0
        line.set_color(array.get(sl_ln, magIdL), color.new(i_magCol, 0))
        line.set_width(array.get(sl_ln, magIdL), math.max(2, i_swW))
        line.set_style(array.get(sl_ln, magIdL), line.style_solid)
        box.set_bgcolor(array.get(sl_bx, magIdL), color.new(i_magCol, 85))
        box.set_border_color(array.get(sl_bx, magIdL), color.new(i_magCol, 40))
        array.push(pLvl, array.get(sl_lvl, magIdL))
        array.push(pTxt, array.get(sl_str, magIdL) ? "◆ " + _sslLbl + " ★" : "◆ " + _sslLbl)
        array.push(pClr, color.new(i_magCol, 0))
        array.push(pSz,  size.normal)
        array.push(pPri, 10)

    // ── Place labels — sort by priority desc, then price desc ────
    //    Skip any label within minGap of an already-placed one
    int n = array.size(pLvl)
    if n > 1
        // bubble sort: primary key = priority desc, secondary = price desc
        for pass = 0 to n - 2
            for j = 0 to n - 2 - pass
                priJ  = array.get(pPri, j)
                priJ1 = array.get(pPri, j + 1)
                lvlJ  = array.get(pLvl, j)
                lvlJ1 = array.get(pLvl, j + 1)
                bool doSwap = priJ < priJ1 or (priJ == priJ1 and lvlJ < lvlJ1)
                if doSwap
                    float tf = array.get(pLvl, j)
                    array.set(pLvl, j,  array.get(pLvl, j + 1))
                    array.set(pLvl, j + 1, tf)
                    string ts = array.get(pTxt, j)
                    array.set(pTxt, j,  array.get(pTxt, j + 1))
                    array.set(pTxt, j + 1, ts)
                    color tc = array.get(pClr, j)
                    array.set(pClr, j,  array.get(pClr, j + 1))
                    array.set(pClr, j + 1, tc)
                    string tsz = array.get(pSz, j)
                    array.set(pSz,  j,  array.get(pSz,  j + 1))
                    array.set(pSz,  j + 1, tsz)
                    int ti = array.get(pPri, j)
                    array.set(pPri, j,  array.get(pPri, j + 1))
                    array.set(pPri, j + 1, ti)

    array<float> placed = array.new<float>()
    if n > 0
        for i = 0 to n - 1
            lvl = array.get(pLvl, i)
            bool tooClose = false
            if array.size(placed) > 0
                for k = 0 to array.size(placed) - 1
                    if math.abs(lvl - array.get(placed, k)) < minGap
                        tooClose := true
                        break
            if not tooClose
                lbl = label.new(r, lvl,
                     text=array.get(pTxt, i),
                     style=label.style_none,
                     textcolor=array.get(pClr, i),
                     size=array.get(pSz, i))
                array.push(dynLbls, lbl)
                array.push(placed, lvl)

// ══════════════════════════════════════════════════════════════════
//  LEGEND
// ══════════════════════════════════════════════════════════════════

var table leg = table.new(position.top_right, 1, 9,
     bgcolor=color.new(#1B2631, 15), border_width=0,
     frame_color=color.new(#37474F, 0), frame_width=1)

if barstate.islastconfirmedhistory
    table.cell(leg, 0, 0, "  LIQUIDITY ZONES  ",
         text_color=#ECEFF1, text_size=size.normal, bgcolor=#1B2631)
    table.cell(leg, 0, 1, "━━  PDH / PDL",
         text_color=i_pdhCol, text_size=size.small)
    table.cell(leg, 0, 2, "╍╍  EQH / EQL",
         text_color=color.new(i_eqhCol, 0), text_size=size.small)
    table.cell(leg, 0, 3, "- -  HTF  (" + i_htfTF + ")",
         text_color=color.new(i_htfHC, 0), text_size=size.small)
    table.cell(leg, 0, 4, "···  Swing H / L",
         text_color=color.new(i_bslCol, 50), text_size=size.small)
    table.cell(leg, 0, 5, "◆   TARGET  (magnet)   ★ = strong pivot",
         text_color=color.new(i_magCol, 0), text_size=size.small)
    table.cell(leg, 0, 6, "FP  FP confirmed zone",
         text_color=color.new(i_fvCol, 0), text_size=size.small)
    table.cell(leg, 0, 8, "▲ABS / ▼DIST  Absorption sweep",
         text_color=#ECEFF1, text_size=size.small)

if barstate.islast
    string fpStatus = na(fpAvgAbs)
         ? (array.size(fpWindow) < 20
              ? "FP: loading (" + str.tostring(array.size(fpWindow)) + "/20)"
              : "FP: no data")
         : "FP: OK  avg |δ| = " + str.tostring(math.round(fpAvgAbs, 0))
    color fpDiagCol = na(fpAvgAbs) ? #FF5722 : color.new(i_fvCol, 0)
    table.cell(leg, 0, 7, fpStatus, text_color=fpDiagCol, text_size=size.small)
